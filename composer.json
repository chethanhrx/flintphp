{
    "name": "flintphp/framework",
    "description": "A fast, secure, modern PHP framework for building production-ready APIs and web applications.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Chethan kumar H R",
            "email": "chethankumarhr751@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.2",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "FlintPHP\\Framework\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FlintPHP\\Framework\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
